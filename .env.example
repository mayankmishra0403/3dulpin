# ============================================================
# 3D ULPIN — environment template
# Copy to .env and adjust for local use.
# ============================================================

# --- Database (PostGIS) ---
POSTGRES_USER=cadastre
POSTGRES_PASSWORD=cadastre
POSTGRES_DB=ulpin3d
POSTGRES_PORT=5433
DATABASE_URL=postgresql://cadastre:cadastre@localhost:5433/ulpin3d

# --- Backend ---
BACKEND_PORT=8000
DATA_DIR=./data

# --- Demo locality (for synthetic dataset generation) ---
DEMO_STATE_CODE=06          # Haryana (DoLR-style 2-digit code)
DEMO_DISTRICT_CODE=08       # Gurugram
DEMO_SUB_DISTRICT_CODE=07   # Gurugram tehsil
DEMO_VILLAGE_CODE=04        # Demo locality within tehsil
DEMO_UTM_ZONE=32643         # UTM 43N (covers Gurugram)